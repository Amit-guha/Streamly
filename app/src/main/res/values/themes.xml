<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
    android:Theme.Material.Light.NoActionBar predates edge-to-edge and declares no status/nav bar
    attributes, so the OS falls back to its own defaults - notably status bar contrast enforcement,
    which lays a translucent scrim behind a transparent status bar to guarantee icon legibility,
    independent of anything the app draws. Declaring these here (resolved once, at window creation)
    is more reliable than a runtime Window API call in onCreate(), which some OS-level re-resolution
    can still override later. Streamly already guarantees its own contrast (see MainActivity /
    SystemBarsAppearance), so the OS scrim is unwanted.
    -->
    <style name="Theme.Streamly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>